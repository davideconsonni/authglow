# ==============================================================================
# GENERAL APPLICATION SETTINGS
# ==============================================================================
APP_NAME=AuthGlow
APP_ENV=development # Use 'production' for live environments
DEBUG=true # Should be 'false' in production
ENABLE_DOCS=true # Set to 'false' to hide /docs, /redoc, /openapi.json
BASE_URL=http://localhost:8001 # Crucial for generating correct links in emails and OIDC discovery

# ==============================================================================
# SECURITY SETTINGS - CHANGE THESE IN PRODUCTION!
# ==============================================================================
# Generate these with `openssl rand -hex 32` or a similar tool.
SECRET_KEY=aba1f92983c7b7b7cda539eceb84970f166a0a550541c352b44d901da5d9ef00

JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# JWK KEY ROTATION
# ==============================================================================
# RSA keys are stored in a keyring (data/keys/keyring.json) supporting
# multiple keys for seamless rotation without downtime.
# JWT_KEY_ROTATION_DAYS=90   # Auto-rotate active key after N days on app restart
# JWT_AUTO_ROTATE=true       # Enable automatic key rotation on startup

# ==============================================================================
# SERVER SETTINGS
# ==============================================================================
HOST=0.0.0.0
PORT=8001

# ==============================================================================
# STORAGE SETTINGS (fsspec)
# ==============================================================================
# For local development (default)
STORAGE_BACKEND=file
STORAGE_PATH=./data/users

# --- Cloud Storage Examples (uncomment and configure one if needed) ---
# For AWS S3
# STORAGE_BACKEND=s3
# STORAGE_PATH=s3://your-bucket-name/authglow/users
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# For Google Cloud Storage
# STORAGE_BACKEND=gcs
# STORAGE_PATH=gs://your-bucket-name/authglow/users
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# For Azure Blob Storage
# STORAGE_BACKEND=abfs
# STORAGE_PATH=abfs://your-container@your-account.dfs.core.windows.net/authglow/users
# AZURE_STORAGE_ACCOUNT_NAME=your-account
# AZURE_STORAGE_ACCOUNT_KEY=your-key

# ==============================================================================
# PASSWORD POLICY
# ==============================================================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true

# ==============================================================================
# OAUTH 2.0 / OPENID CONNECT (OIDC) SETTINGS
# ==============================================================================
# The issuer URL is the base URL of your AuthGlow instance.
# It MUST match the BASE_URL for OIDC discovery to work correctly.
ISSUER=http://localhost:8001

OAUTH2_AUTHORIZATION_CODE_EXPIRE_MINUTES=10

# If true, rejects OAuth requests containing scopes not allowed for the client.
# If false (default), it filters out the unknown scopes and proceeds.
OAUTH2_REJECT_UNKNOWN_SCOPES=false

# Default client created on first startup (optional)
OAUTH2_CLIENT_ID=default-client-id
OAUTH2_CLIENT_SECRET=default-client-secret

# ==============================================================================
# CORS SECURITY SETTINGS
# ==============================================================================
# IMPORTANT: Configure these settings carefully to prevent security vulnerabilities.
#
# Allowed origins (comma-separated list of URLs that can make requests to your API)
# For production: Use specific origins like "https://app.example.com,https://admin.example.com"
# For development: Use "http://localhost:3000,http://localhost:8080"
# WARNING: NEVER use "*" in production when allow_credentials is true!
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:6060,http://127.0.0.1:6060,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173

# Allow cookies and credentials in cross-origin requests
CORS_ALLOW_CREDENTIALS=true

# Allowed HTTP methods (comma-separated)
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Allowed headers (explicit list required when allow_credentials=true)
CORS_ALLOWED_HEADERS=Authorization, Content-Type, X-Requested-With, Accept

# ==============================================================================
# REQUEST BODY SIZE LIMIT
# ==============================================================================
# Maximum allowed request body size in megabytes.
# Requests exceeding this limit receive a 413 Payload Too Large response.
MAX_REQUEST_BODY_SIZE_MB=10

# ==============================================================================
# SECURITY HEADERS (HTTP Response Headers)
# ==============================================================================
# HSTS is only applied when APP_ENV=production
# CSP_HEADER=default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'
# X_FRAME_OPTIONS=DENY
# X_CONTENT_TYPE_OPTIONS=nosniff
# REFERRER_POLICY=strict-origin-when-cross-origin
# X_PERMITTED_CROSS_DOMAIN_POLICIES=none
# PERMISSIONS_POLICY=  # leave empty to disable; eg: "camera=(), microphone=()"
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=true

# --- API Key brute-force lockout ---
# API_KEY_MAX_FAILED_ATTEMPTS=5     # Lock after N consecutive failed validations
# API_KEY_LOCKOUT_MINUTES=15         # Duration of the lockout

# --- Backup code brute-force lockout ---
# BACKUP_CODE_MAX_FAILED_ATTEMPTS=3  # Lock after N consecutive failed backup codes
# BACKUP_CODE_LOCKOUT_SECONDS=30     # Duration of the lockout in seconds

# ==============================================================================
# HTTPS ENFORCEMENT
# ==============================================================================
# When APP_ENV=production and ENFORCE_HTTPS=true, all HTTP requests are
# redirected to HTTPS with the configured redirect status code.
# Supports X-Forwarded-Proto header for reverse proxy (nginx/ALB) scenarios.
# ENFORCE_HTTPS=true
# HTTPS_REDIRECT_STATUS=301   # 301 permanent, 302 temporary

# ==============================================================================
# PASSKEY (WEBAUTHN / FIDO2) SETTINGS
# ==============================================================================
# The Relying Party ID. For production, this should be your domain name (e.g., "example.com").
PASSKEY_RP_ID=localhost
# The name of your application displayed to the user during passkey creation.
PASSKEY_RP_NAME=AuthGlow
# The origin URL of your application. MUST match BASE_URL in production.
PASSKEY_ORIGIN=http://localhost:8001

# ==============================================================================
# EMAIL SETTINGS
# ==============================================================================
# 'console': Prints emails to the console (for development).
# 'file_storage': Saves emails as JSON files in `EMAIL_STORAGE_PATH`.
# 'smtp', 'sendgrid', 'mailgun': For sending real emails (configure below).
EMAIL_BACKEND=file_storage
EMAIL_FROM_ADDRESS=noreply@authglow.example.com
EMAIL_FROM_NAME=AuthGlow
EMAIL_STORAGE_PATH=data/users/emails

# --- SMTP Settings ---
# Uncomment and configure if EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=your-password
# SMTP_USE_TLS=true

# --- SendGrid Settings ---
# Uncomment and configure if EMAIL_BACKEND=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# --- Mailgun Settings ---
# Uncomment and configure if EMAIL_BACKEND=mailgun
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain

# ==============================================================================
# CACHE SETTINGS (In-Process TTL Caches)
# ==============================================================================
# These caches live in-process only (no Redis/Memcached dependency yet).
# Distributed caching is planned for Phase 5.
# CACHE_REFRESH_TOKEN_MAXSIZE=5000   # Max entries in refresh_token token_id cache
# CACHE_REFRESH_TOKEN_TTL=60         # TTL seconds (skip prefix-index on hot tokens)
# CACHE_USER_MAXSIZE=2000            # Max entries in user lookup cache
# CACHE_USER_TTL=300                 # TTL seconds (eventual-consistency window)
