# Application Settings
APP_NAME=AuthGlow
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Settings
HOST=0.0.0.0
PORT=8000

# Storage Settings (fsspec)
# For local development
STORAGE_BACKEND=file
STORAGE_PATH=./data/users

# For AWS S3
# STORAGE_BACKEND=s3
# STORAGE_PATH=s3://your-bucket-name/authglow/users
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# For Google Cloud Storage
# STORAGE_BACKEND=gcs
# STORAGE_PATH=gs://your-bucket-name/authglow/users
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# For Azure Blob Storage
# STORAGE_BACKEND=abfs
# STORAGE_PATH=abfs://your-container@your-account.dfs.core.windows.net/authglow/users
# AZURE_STORAGE_ACCOUNT_NAME=your-account
# AZURE_STORAGE_ACCOUNT_KEY=your-key

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true

# UI Customization
UI_LOGO_URL=
UI_PRIMARY_COLOR=#4F46E5
UI_SECONDARY_COLOR=#06B6D4
UI_BACKGROUND_COLOR=#FFFFFF
UI_TEXT_COLOR=#1F2937
UI_COMPANY_NAME=AuthGlow
UI_SUPPORT_EMAIL=support@example.com
UI_PRIVACY_POLICY_URL=
UI_TERMS_OF_SERVICE_URL=

# OAuth2 Settings
OAUTH2_AUTHORIZATION_CODE_EXPIRE_MINUTES=10
OAUTH2_CLIENT_ID=default-client-id
OAUTH2_CLIENT_SECRET=default-client-secret
