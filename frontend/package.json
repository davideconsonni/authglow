    "@radix-ui/react-tooltip": "^1.2.16",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
